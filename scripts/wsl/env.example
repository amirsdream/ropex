# Ropex local environment — copied to ./.env by `scripts/wsl-setup.sh`.
# Nothing loads this file automatically; export it into your shell first:
#
#   set -a && source .env && set +a
#
# `scripts/wsl-setup.sh` adds that line to ~/.bashrc guarded by a cd check,
# so a shell opened inside the repo picks it up. Everything here is optional —
# the defaults (embedded Hermes + embedded harness) run offline with no keys.

# --- Control plane ---------------------------------------------------------
ROPEX_PORT=7780

# --- Backends --------------------------------------------------------------
# embedded (default, network-free) | live (needs the optional npm trees + keys)
# ROPEX_HERMES_BACKEND=live
# ROPEX_DSH_BACKEND=live
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Worker runtimes (docs/worker-runtimes.md) -----------------------------
# ROPEX_RUNTIME_BIN_CLAUDE_CODE=/home/you/.nvm/versions/node/v22/bin/claude

# --- GitHub ingress (docs/api.md) ------------------------------------------
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=

# --- Git ingress -----------------------------------------------------------
# 1 enables real clones in watch/clone paths. Leave unset for offline work.
# ROPEX_GIT_CLONE=0
