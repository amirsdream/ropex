{
  "name": "ropex",
  "version": "0.1.0",
  "description": "GitOps control plane for agent fleets. DeepSeek Harness + Hermes Agent, derived from git.",
  "type": "module",
  "bin": {
    "ropex": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "npm --prefix web install --no-fund --no-audit && npm --prefix web run build",
    "dev": "tsx src/cli.ts",
    "web:dev": "npm --prefix web run dev",
    "up": "bash scripts/stack-up.sh",
    "down": "bash scripts/stack-down.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "hermes-agent": "^0.20.6",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
